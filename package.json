{
  "name": "dsh-always-allow",
  "version": "0.1.0",
  "description": "Codex-style \"always allow commands that start with …\" for DeepSeek Harness approvals: a one-click prefix rule written into the workspace rules file that dsh-permission-rules already reads.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.js",
  "sideEffects": false,
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./config": "./src/config.js",
    "./prefix": "./src/prefix.js",
    "./rules-file": "./src/rules-file.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check src/index.js && node --check src/client.js && node --check src/config.js && node --check src/prefix.js && node --check src/rules-file.js && node --check src/endpoints.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "always-allow",
    "permission",
    "allow-prefix"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
